# ============================================================
# 数据库切换说明（仅改配置，无需改代码）
# ============================================================
#
# 1) SQLite（默认，本地开发/ECS 单机）
# mailcursor:
#   database:
#     type: sqlite
#   data-dir: ./data
# spring:
#   datasource:
#     url: jdbc:sqlite:${mailcursor.data-dir}/mailcursor.db
#     driver-class-name: org.sqlite.JDBC
#
# 2) MySQL
# mailcursor:
#   database:
#     type: mysql
# spring:
#   datasource:
#     url: jdbc:mysql://127.0.0.1:3306/mailcursor?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
#     driver-class-name: com.mysql.cj.jdbc.Driver
#     username: root
#     password: your-password
#
# 3) PostgreSQL
# mailcursor:
#   database:
#     type: postgres
# spring:
#   datasource:
#     url: jdbc:postgresql://127.0.0.1:5432/mailcursor
#     driver-class-name: org.postgresql.Driver
#     username: postgres
#     password: your-password
#
# 4) Oracle
# mailcursor:
#   database:
#     type: oracle
# spring:
#   datasource:
#     url: jdbc:oracle:thin:@127.0.0.1:1521:ORCL
#     driver-class-name: oracle.jdbc.OracleDriver
#     username: mailcursor
#     password: your-password
#
# DDL 脚本目录：src/main/resources/ddl/{sqlite|mysql|postgres|oracle}/
# 启动时会自动按 database.type 执行对应目录下的 SQL 文件。
#
# 数据访问层使用 MyBatis，SQL 统一在 src/main/resources/mapper/ 下 XML 定义，
# 参数均通过 #{} 绑定，分页/日期函数等方言差异通过 databaseId 区分。
