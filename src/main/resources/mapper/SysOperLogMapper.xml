<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mailcursor.mapper.SysOperLogMapper">

    <resultMap id="SysOperLogMap" type="com.mailcursor.operlog.model.SysOperLog">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="moduleName" column="module_name"/>
        <result property="menuName" column="menu_name"/>
        <result property="operType" column="oper_type"/>
        <result property="operDesc" column="oper_desc"/>
        <result property="requestUri" column="request_uri"/>
        <result property="requestMethod" column="request_method"/>
        <result property="clientIp" column="client_ip"/>
        <result property="status" column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="operLogWhere">
        <where>
            <if test="username != null and username != ''">
                AND username LIKE #{username}
            </if>
            <if test="operType != null and operType != ''">
                AND oper_type = #{operType}
            </if>
            <if test="menuName != null and menuName != ''">
                AND menu_name LIKE #{menuName}
            </if>
        </where>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_oper_log (user_id, username, module_name, menu_name, oper_type, oper_desc,
                                  request_uri, request_method, client_ip, status, error_message, created_at)
        VALUES (#{userId}, #{username}, #{moduleName}, #{menuName}, #{operType}, #{operDesc},
                #{requestUri}, #{requestMethod}, #{clientIp}, #{status}, #{errorMessage}, #{createdAt})
    </insert>

    <select id="countByQuery" resultType="int">
        SELECT COUNT(1) FROM sys_oper_log
        <include refid="operLogWhere"/>
    </select>

    <select id="selectByQuery" resultMap="SysOperLogMap">
        SELECT id, user_id, username, module_name, menu_name, oper_type, oper_desc,
               request_uri, request_method, client_ip, status, error_message, created_at
        FROM sys_oper_log
        <include refid="operLogWhere"/>
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectByQuery" resultMap="SysOperLogMap" databaseId="oracle">
        SELECT id, user_id, username, module_name, menu_name, oper_type, oper_desc,
               request_uri, request_method, client_ip, status, error_message, created_at
        FROM sys_oper_log
        <include refid="operLogWhere"/>
        ORDER BY id ASC
        OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY
    </select>
</mapper>
